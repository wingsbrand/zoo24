# ZOO24 — przykładowa konfiguracja. NIGDY nie wpisuj tu prawdziwych wartości.
# Prawdziwe sekrety tylko w menedżerze sekretów hostingu (po osobnej zgodzie właściciela).

# local | staging | production  (wszystko poza production => noindex)
ZOO24_ENV=local
# Publiczny adres serwisu (canonical/sitemap). Lokalnie:
ZOO24_SITE_URL=http://localhost:3024

# Tryb social: 0 = offline/mock (domyślny). 1 = wymaga osobnej akceptacji właściciela.
ZOO24_SOCIAL_MODE=0
# Realne integracje — w F1 muszą być "false". Adaptery real rzucają błąd, jeśli flaga jest wyłączona.
ZOO24_META_LIVE=false
ZOO24_GSC_LIVE=false
ZOO24_GA4_LIVE=false

# Sekrety (puste; wypełniane wyłącznie w sekret managerze po zgodzie):
META_APP_ID=
META_APP_SECRET=
META_PAGE_ACCESS_TOKEN=
GSC_SERVICE_ACCOUNT_JSON=
GA4_PROPERTY_ID=

# Magazyn danych (produkcja): Supabase. Klucz sekretny wyłącznie w Vercel (typ Sensitive), nigdy w repo.
ZOO24_SUPABASE_URL=
ZOO24_SUPABASE_SECRET_KEY=

# Weryfikacja własności domeny (publiczne kody z meta tagu, nie sekrety):
# Google Search Console -> wartość atrybutu content z <meta name="google-site-verification">
ZOO24_GSC_VERIFICATION=
# Ahrefs Webmaster Tools -> wartość content z <meta name="ahrefs-site-verification">
ZOO24_AHREFS_VERIFICATION=

# Prototyp: akcje panelu admin chronione prostym nagłówkiem/ciasteczkiem tylko lokalnie.
ZOO24_ADMIN_LOCAL_ONLY=true
